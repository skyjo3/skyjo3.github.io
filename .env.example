# Copy this file to .env (which is gitignored) and fill in the values.
# Generate the hash with: node scripts/hash-password.js <yourpassword>
REACT_APP_PROJECT_PASSWORD_HASH=

# From: terraform output api_endpoint  (in the portfolio-infra repo)
REACT_APP_API_ENDPOINT=

# From: terraform output cloudfront_domain  (in the portfolio-infra repo)
REACT_APP_CDN_DOMAIN=
